<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shizuku_dialog_background"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="22dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/shizuku_warning_circle">

      <ImageView
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_gravity="center"
          android:contentDescription="@string/shizuku_warning_icon_description"
          android:src="@drawable/ic_shizuku_warning" />
    </FrameLayout>

    <TextView
        android:id="@+id/shizuku_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:text="@string/shizuku_not_installed_title"
        android:textColor="@color/shizuku_dialog_title"
        android:textSize="22sp"
        android:textStyle="bold" />
  </LinearLayout>

  <TextView
      android:id="@+id/shizuku_dialog_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="22dp"
      android:lineSpacingExtra="5dp"
      android:text="@string/shizuku_not_installed_message"
      android:textColor="@color/shizuku_dialog_body"
      android:textSize="16sp" />

  <Button
      android:id="@+id/shizuku_install_button"
      android:layout_width="match_parent"
      android:layout_height="58dp"
      android:layout_marginTop="28dp"
      android:background="@drawable/shizuku_primary_button"
      android:backgroundTint="@null"
      android:gravity="center"
      android:minHeight="0dp"
      android:padding="0dp"
      android:text="@string/shizuku_install_bundled"
      android:textAllCaps="false"
      android:textColor="@android:color/white"
      android:textSize="17sp"
      android:stateListAnimator="@null" />

  <TextView
      android:id="@+id/shizuku_later_button"
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:layout_marginTop="12dp"
      android:background="?android:attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center"
      android:text="@string/shizuku_later"
      android:textColor="@color/shizuku_dialog_secondary_action"
      android:textSize="16sp" />
</LinearLayout>
